<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Source/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../Source/Game/*.cs" Link="Game/%(Filename)%(Extension)" />
    <Compile Include="../Source/UI/*.cs" Link="UI/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
